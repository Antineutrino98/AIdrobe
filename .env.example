# 复制本文件为 .env 后按实际情况填写；这里全部是占位示例，不含任何真实密钥。
# AIdrobe.md：代码中禁止硬编码模型名 / base_url / api_key，一律从环境变量读。

# ---------------------------------------------------------------- PGlite
# 后端选择：py_pglite（默认，pip 包）| pglite_socket（官方 pglite-server 子进程）
PGLITE_BACKEND=py_pglite
# 数据目录与备份目录（均不提交 git）
PGLITE_DATA_DIR=data/pglite
PGLITE_BACKUP_DIR=data/pglite-backups
# 备份策略：至少间隔多少小时备份一次、最多保留几份
PGLITE_BACKUP_INTERVAL_HOURS=24
PGLITE_BACKUP_KEEP=7
# 本地图片目录（M2 也接受历史变量名 IMAGE_STORAGE_DIR）
IMAGE_DIR=data/images
# 没有认证模块时，请求未带 owner_id 的兜底用户；留空则要求请求显式提供
AIDROBE_DEFAULT_OWNER_ID=
# py_pglite 起的本地 TCP 端口；避开标准 5432，防止和别的数据库抢端口
PGLITE_TCP_HOST=127.0.0.1
PGLITE_TCP_PORT=55432
# 只有选 pglite_socket 后端时才需要：启动 pglite-server 的命令模板
# PGLITE_SOCKET_BIN=npx pglite-server
# 如果数据库服务已在外部启动，可直接给连接串（留空则由 db_gateway 负责启动）
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/postgres

# ------------------------------------------- 模型供应商（Qwen / 阿里云百炼）
# 三个角色可以共用同一套 base_url / model；角色专属变量优先。
QWEN_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
# API Key 推荐在前端「模型设置」里输入（存在浏览器 localStorage）。
# 这里留空即可；如果填了，会作为后端兜底。
DASHSCOPE_API_KEY=

# ------------------------------------------- 模型角色 1：视觉提取（入库）
# VISION_EXTRACTOR：能看图，输出严格 JSON
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_IMAGE_FORMAT=data_url

# ------------------------------------------- 模型角色 2：文本规划
# TEXT_PLANNER：纯文本，输出严格 JSON
PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_MODEL=

# ------------------------------------------- 模型角色 3：多模态搭配
# MULTIMODAL_STYLIST：能看图 + 强推理，输出严格 JSON
STYLIST_BASE_URL=
STYLIST_API_KEY=
STYLIST_MODEL=
STYLIST_IMAGE_FORMAT=data_url
STYLIST_MAX_IMAGES=30
STYLIST_IMAGE_MAX_TOKENS=1280

# ---------------------------------------------------------------- 其他
# 天气 API 基址（Open-Meteo）；城市地理编码仍用其官方域名
WEATHER_API_BASE=https://api.open-meteo.com/v1
# 购前决策默认严格度。M4 冻结的取值是 conservative / permissive；
# M7.md 写的 moderate 会被映射为 conservative。
DEFAULT_STRICTNESS=conservative

# ---------------------------------------------------------------- Embedding（可选）
# 不配置则跳过向量生成，入库/推荐照常工作，只影响查重与相似度。
# 兼容两种写法：EMBEDDING_API_URL 优先，其次 EMBEDDING_API_BASE。
EMBEDDING_API_URL=
# EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
